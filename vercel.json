{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/timetable/reset",
      "destination": "/api/reset"
    },
    {
      "source": "/api/timetable",
      "destination": "/api/timetable"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

